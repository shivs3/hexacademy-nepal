[Unit]
Description=Hexacademy Nepal Django API (Gunicorn)
After=network.target postgresql.service hexacademy-redis.service
Wants=hexacademy-redis.service

[Service]
User=hexacademy
Group=hexacademy
WorkingDirectory=/var/www/SHIV/hexacademy-nepal/backend
EnvironmentFile=/var/www/SHIV/hexacademy-nepal/backend/.env
Environment=GUNICORN_BIND=127.0.0.1:8050
Environment=GUNICORN_WORKERS=3
ExecStart=/var/www/SHIV/hexacademy-nepal/backend/.venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
