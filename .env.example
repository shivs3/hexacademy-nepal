# Copy to `.env` (compose) or `backend/.env` (local dev) and fill in real values.
# PLACEHOLDERS ONLY — never commit a filled-in copy.

# --- Django
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-64
DJANGO_ALLOWED_HOSTS=hexacademynepal.com,www.hexacademynepal.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://hexacademynepal.com,https://www.hexacademynepal.com
CORS_ALLOWED_ORIGINS=https://hexacademynepal.com
FRONTEND_URL=https://hexacademynepal.com
DJANGO_HSTS_PRELOAD=false
LOG_LEVEL=INFO
# Development settings only, for local end-to-end runs; ignored in production.
# DJANGO_E2E_RELAXED_THROTTLES=true

# --- Database (compose builds DATABASE_URL from these; PostgreSQL is internal-only)
POSTGRES_DB=hexacademy
POSTGRES_USER=hexacademy
POSTGRES_PASSWORD=change-me
# Local dev without compose:
# DATABASE_URL=postgres:///hexacademy_dev

# --- Redis / Celery (compose sets REDIS_URL automatically)
# REDIS_URL=redis://localhost:6379/0

# --- Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=Hexacademy Nepal <no-reply@hexacademynepal.com>

# --- Object storage (Cloudflare R2 or any S3-compatible service)
USE_S3_STORAGE=false
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=auto
S3_PUBLIC_BUCKET=hexacademy-public
# S3_PUBLIC_CUSTOM_DOMAIN=media.hexacademynepal.com
S3_PRIVATE_BUCKET=hexacademy-private
PRIVATE_URL_TTL_SECONDS=300
MAX_UPLOAD_SIZE_MB=50

# --- Payments (values from the provider merchant dashboards; see docs/deployment.md)
# A gateway counts as configured as soon as its key is non-empty, so leave these
# blank until you have real values. Defaults point at each provider's test system.
KHALTI_SECRET_KEY=
# KHALTI_BASE_URL=        sandbox by default; production URL per Khalti's docs
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# ESEWA_FORM_URL=         UAT by default; production URLs per eSewa's docs
# ESEWA_STATUS_URL=
# Local simulator only. Production refuses to start when this is true.
PAYMENTS_ENABLE_SANDBOX=false
# PAYMENTS_SANDBOX_SECRET=

# --- Frontend
NEXT_PUBLIC_SITE_URL=https://hexacademynepal.com
# Content-Security-Policy extras (space-separated origins; see docs/security.md).
# CSP_MEDIA_ORIGINS=https://media.hexacademynepal.com
# Must include the origin of ESEWA_FORM_URL, or the eSewa checkout form is blocked.
# CSP_FORM_ACTION_ORIGINS=https://rc-epay.esewa.com.np
# Optional endpoint that receives CSP violation reports.
# CSP_REPORT_URI=
HTTP_PORT=80
